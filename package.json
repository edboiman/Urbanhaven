{
  "name": "urban-haven",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Offline preparedness companion for Michigan households: living 14-day checklist, water safety, offline Michigan map, pantry meals and garden planning.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173 /",
    "typecheck": "tsc -p . && tsc -p tsconfig.tests.json",
    "test": "node scripts/test.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check": "npm run check:content && npm run typecheck && npm test && npm run build",
    "test:e2e": "node e2e/run-all.mjs",
    "map:data": "node scripts/map/build-map-data.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
